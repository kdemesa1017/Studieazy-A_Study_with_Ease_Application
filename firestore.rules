rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — authenticated users can read/write/delete (enables admin user deletion and management)
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Quizzes — authenticated users can read/write/delete
    match /quizzes/{quizId} {
      allow read, write: if request.auth != null;
    }

    // Questions — authenticated users can read/write/delete
    match /questions/{questionId} {
      allow read, write: if request.auth != null;
    }

    // Support Tickets — users can create and read; admins can manage all
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Error Logs — any client can log; authenticated users can read/clear
    match /error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // System Config — authenticated users can read configuration
    match /system_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // OTP codes — managed strictly by backend Admin SDK (serverless functions), disallowed for client apps directly
    match /otp_codes/{docId} {
      allow read, write: if false;
    }
  }
}
