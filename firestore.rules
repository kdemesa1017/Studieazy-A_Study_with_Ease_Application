rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents — users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Quizzes — owner can read/write; authenticated users can create own quizzes
    match /quizzes/{quizId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Questions — authenticated users can read/write questions belonging to their quizzes
    match /questions/{questionId} {
      allow read, write: if request.auth != null;
    }

    // OTP codes — managed strictly by backend Admin SDK (serverless functions), disallowed for client apps directly
    match /otp_codes/{docId} {
      allow read, write: if false;
    }
  }
}
